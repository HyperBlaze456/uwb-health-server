# SPEC 4.3. 이 파일을 .env로 복사해 값을 바꿈. .env는 git에 넣지 않음.
DB_HOST=db
DB_PORT=5432
DB_NAME=uwb
DB_OWNER=uwb
DB_PASSWORD=change-me-owner
DB_INTAKE_PASSWORD=change-me-intake
DB_CORE_PASSWORD=change-me-core
DB_API_PASSWORD=change-me-api

# 호스트의 파일 뿌리(compose가 컨테이너의 /data에 붙임). 프로세스 안의 뿌리는 DATA_ROOT(기본 /data).
DATA_DIR=/srv/uwb

GAITFUSION_URL=http://gaitfusion:8100
GAITFUSION_TIMEOUT_S=600
ANALYSIS_WORKERS=1
ANALYSIS_PARAMS={}

SEGMENT_SILENCE_S=60
SEGMENT_GAP_S=60
SEGMENT_MAX_S=3600
ARCHIVE_PAD_S=15
RAW_RETENTION_DAYS=30
# 30일 삭제 스위치(AR-7). AI 모델(걷기 구간 찾기)을 실제 기록으로 확인하기 전에는 false.
PURGE_ENABLED=false
PURGE_AT_UTC=18:00
APP_TOKEN_TTL_DAYS=30
